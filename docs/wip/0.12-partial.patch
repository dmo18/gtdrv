+        console.log(`${c.ok ? 'ok  ' : 'FAIL'} ${c.key}: ${c.value} (limit ${c.limit})`);
+        if (!c.ok) failed = true;
+      }
+    }
+  } catch (e) {
+    console.log('FAIL', e.message);
+    failed = true;
+  } finally {
+    server.close();
+    await rm(dist, { recursive: true, force: true });
+  }
+  process.exit(failed ? 1 : 0);
+}
+
+if (process.argv[1] === fileURLToPath(import.meta.url)) await main();
