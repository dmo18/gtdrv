diff --git a/test/custom.test.js b/test/custom.test.js
new file mode 100644
index 0000000..603750c
--- /dev/null
+++ b/test/custom.test.js
@@ -0,0 +1,117 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import {
+  PAINTS, FINISHES, WHEELS, TINTS, DECALS, defaultLook, isDefaultLook, unlocked, lockText, sanitizeLook, paintCode, codeRgb, codeFinish, codeDecal, LOOK_KEYS,
+} from '../src/core/custom.js';
+import { createCustom } from '../src/systems/custom.js';
+import { defaultProgress } from '../src/core/save.js';
+import { createEvents } from '../src/core/events.js';
+import { createVehicle } from '../src/entities/vehicle.js';
+import { createVehicleMesh, noteVehicleHit, updateVehicleMesh } from '../src/render/vehiclemesh.js';
+import { paintMaterial, wheelMaterial, wheelLookMaterial, carGlassMaterial } from '../src/render/vehiclemats.js';
+import { createRng } from '../src/core/rng.js';
+import { recordEvent } from '../src/core/records.js';
+
+test('the base set is open from the start; medals open the rest; nothing costs anything', () => {
+  assert.ok(PAINTS.length >= 12 && FINISHES.length >= 4 && WHEELS.length >= 4 && TINTS.length >= 3 && DECALS.length >= 3);
+  for (let i = -1; i < PAINTS.length; i++) assert.ok(unlocked('paint', i, 0, 0));
+  assert.equal(FINISHES.filter((f, i) => unlocked('finish', i, 0, 0)).length, 4, 'four finishes with no medals');
+  assert.equal(WHEELS.filter((w, i) => unlocked('wheels', i, 0, 0)).length, 5);
+  for (let i = 0; i < TINTS.length; i++) assert.ok(unlocked('tint', i));
+  for (let i = 0; i < DECALS.length; i++) assert.ok(unlocked('decal', i));
+  assert.ok(!unlocked('finish', 4, 4, 0) && unlocked('finish', 4, 5, 0));
+  assert.ok(!unlocked('finish', 6, 99, 9) && unlocked('finish', 6, 10, 10));
+  assert.ok(!unlocked('finish', 99, 99, 99) && !unlocked('paint', PAINTS.length) && !unlocked('tint', -1));
+  assert.equal(lockText('finish', 4), '5 medals');
+  assert.equal(lockText('finish', 6), '10 gold medals');
+  assert.equal(lockText('paint', 3), '');
+  for (const f of FINISHES) assert.ok(f[3] > 0, 'the clearcoat is never 0 (one shader program for every finish)');
+  for (const t of [PAINTS, FINISHES, WHEELS, TINTS, DECALS]) for (const row of t) assert.ok(!/\$|coin|credit|buy|price/i.test(row[0]));
+});
+
+test('looks: defaults, strict reading, and the paint code', () => {
+  assert.ok(isDefaultLook(defaultLook()) && isDefaultLook(null));
+  assert.deepEqual(sanitizeLook({ paint: 3, finish: 2, wheels: 1, tint: 3, decal: 4, x: 1 }), { paint: 3, finish: 2, wheels: 1, tint: 3, decal: 4 });
+  assert.deepEqual(sanitizeLook({ paint: 99, finish: -1, wheels: 1.5, tint: '2', decal: null }), defaultLook());
+  for (const junk of [null, 4, 'x', [1, 2]]) assert.deepEqual(sanitizeLook(junk), defaultLook());
+  assert.equal(paintCode(0xc21f1f, 0, 0), 0xc21f1f, 'a plain color is its own code');
+  const code = paintCode(0xf0f0ee, 5, 3);
+  assert.equal(codeRgb(code), 0xf0f0ee);
+  assert.equal(codeFinish(code), 5);
+  assert.equal(codeDecal(code), 3);
+  assert.equal(codeRgb(0x123456), 0x123456);
+  assert.equal(codeFinish(0x123456), 0);
+  assert.deepEqual(LOOK_KEYS, ['paint', 'finish', 'wheels', 'tint', 'decal']);
+});
+
+function world() {
+  const events = createEvents();
+  const game = { events, progress: defaultProgress(), player: { vehicle: null } };
+  game.custom = createCustom(game);
+  const car = (id) => {
+    const v = createVehicle(id, 0, 0, 0, createRng(4));
+    v.mesh = createVehicleMesh(v.spec, v.color);
+    return v;
+  };
+  return { game, car };
+}
+
+test('a look is kept per class and goes on the car the player gets into', () => {
+  const { game, car } = world();
+  const C = game.custom;
+  const a = car('sedan');
+  game.player.vehicle = a;
+  const stock = a.mesh.userData.color;
+  assert.ok(C.set('sedan', 'paint', 0));
+  assert.ok(C.set('sedan', 'finish', 1));
+  assert.ok(C.set('sedan', 'wheels', 3));
+  assert.ok(C.set('sedan', 'tint', 2));
+  assert.ok(C.set('sedan', 'decal', 1));
+  assert.deepEqual(game.progress.loop.looks.sedan, { paint: 0, finish: 1, wheels: 3, tint: 2, decal: 1 });
+  const ud = a.mesh.userData;
+  assert.equal(ud.color, paintCode(PAINTS[0][1], 1, 1));
+  assert.equal(ud.body.material, paintMaterial(ud.color));
+  assert.equal(ud.body.material.metalness, FINISHES[1][1]);
+  assert.equal(ud.body.material.userData.rw.uDecal.value.w, 1);
+  assert.equal(ud.wheelLevels[0].material, wheelLookMaterial(3));
+  assert.notEqual(wheelLookMaterial(3), wheelMaterial());
+  assert.equal(ud.glassLevels[0].material, carGlassMaterial('clean', TINTS[2][1]));
+  assert.equal(a.color, a.spec.colors.includes(a.color) ? a.color : a.color, 'the car keeps the color it came in');
+  // another sedan gets the look on entering; a muscle car does not
+  const b = car('sedan'), m = car('muscle');
+  game.events.emit('enter', b);
+  assert.equal(b.mesh.userData.color, ud.color);
+  game.events.emit('enter', m);
+  assert.equal(m.mesh.userData.color, m.color);
+  assert.equal(m.mesh.userData.look, undefined);
+  // damage swaps wheel and glass materials back to the shared ones; render() restores the look
+  noteVehicleHit(a.mesh, 1, 0, 0, 20);
+  a.health = a.spec.health * 0.3;
+  updateVehicleMesh(a.mesh, a, 1, 0);
+  assert.ok(ud.ownPaint, 'a damaged car has its own paint');
+  assert.equal(ud.ownPaint.metalness, FINISHES[1][1], 'and keeps the finish');
+  C.render();
+  assert.equal(ud.wheelLevels[0].material, wheelLookMaterial(3));
+  assert.equal(ud.glassLevels[0].material, carGlassMaterial(ud.glassState, TINTS[2][1]));
+  // back to stock
+  C.reset('sedan');
+  assert.equal(game.progress.loop.looks.sedan, undefined);
+  assert.equal(ud.color, stock);
+  assert.equal(ud.wheelLevels[0].material, wheelMaterial());
+});
+
+test('locked options are refused until the medals are there; bad options always', () => {
+  const { game, car } = world();
+  const C = game.custom;
+  game.player.vehicle = car('muscle');
+  assert.equal(C.set('muscle', 'finish', 5), false, 'Chrome needs 15 medals');
+  assert.equal(C.set('muscle', 'finish', 99), false);
+  assert.equal(C.set('muscle', 'paint', -2), false);
+  assert.equal(C.set('muscle', 'spoiler', 1), false);
+  assert.equal(C.set('muscle', 'wheels', 5), false);
+  assert.equal(game.progress.loop.looks.muscle, undefined);
+  for (let i = 1; i <= 15; i++) recordEvent(game.progress.loop, { id: 'ev_beach_trap_' + i, tpl: 'trap' }, 80, 'bronze');
+  assert.ok(C.open('finish', 5) && C.set('muscle', 'finish', 5));
+  assert.ok(C.set('muscle', 'wheels', 5));
+  assert.equal(C.open('finish', 6), false, 'Candy needs 10 golds');
+});
diff --git a/test/daily.test.js b/test/daily.test.js
new file mode 100644
index 0000000..fb96428
--- /dev/null
+++ b/test/daily.test.js
@@ -0,0 +1,97 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { dayKey, validDay, dailyThree, rollDay, completeDaily, GROUPS, TWIST_KINDS, TWIST_CLASSES } from '../src/core/daily.js';
+import { createDaily } from '../src/systems/daily.js';
+import { defaultProgress } from '../src/core/save.js';
+import { createEvents } from '../src/core/events.js';
+import { VEHICLE_SPECS } from '../src/entities/vehicle.js';
+
+const list = [];
+for (const tpl of ['trap', 'miss', 'jump', 'dash', 'heat', 'wreck']) for (let i = 1; i <= 4; i++) list.push({ id: 'ev_beach_' + tpl + '_' + i, tpl, name: tpl + i, intro: tpl === 'miss' && i === 1 });
+
+test('the day key is the local date, read from a Date', () => {
+  assert.equal(dayKey(new Date(2026, 10, 23, 23, 59)), 20261123);
+  assert.equal(dayKey(new Date(2027, 0, 1, 0, 0)), 20270101);
+  assert.equal(dayKey(new Date('bad')), 20260101);
+  assert.equal(dayKey(null), 20260101);
+  assert.ok(validDay(20261123) && !validDay(0) && !validDay(2026.5) && !validDay(99999999));
+});
+
+test('three picks a day: one of each group, a different twist each, the same all day', () => {
+  const a = dailyThree(list, 20261123, 'beach', { muscle: 'Redtail' });
+  const b = dailyThree(list, 20261123, 'beach', { muscle: 'Redtail' });
+  assert.deepEqual(a, b);
+  assert.equal(a.length, 3);
+  a.forEach((p, i) => {
+    assert.equal(p.slot, i);
+    assert.ok(GROUPS[i].includes(p.ev.tpl));
+    assert.ok(!p.ev.intro, 'the first gate is never a daily');
+    assert.ok(p.twist.text.length > 3);
+  });
+  assert.deepEqual(a.map((p) => p.twist.kind).sort(), TWIST_KINDS.slice().sort());
+  for (const id of TWIST_CLASSES) assert.ok(VEHICLE_SPECS[id], id + ' is a real car class');
+  // the days differ, and so do the regions
+  const seen = new Set();
+  for (let d = 20261101; d <= 20261130; d++) seen.add(dailyThree(list, d, 'beach').map((p) => p.ev.id + p.twist.text).join());
+  assert.ok(seen.size >= 25, 'thirty days give at least 25 different sets: ' + seen.size);
+  assert.notDeepEqual(dailyThree(list, 20261123, 'north').map((p) => p.ev.id + p.twist.text), a.map((p) => p.ev.id + p.twist.text));
+  // a region without a group's templates gets fewer, not an error
+  assert.equal(dailyThree(list.filter((e) => e.tpl === 'trap'), 20261123, 'beach').length, 1);
+  assert.deepEqual(dailyThree([], 20261123, 'beach'), []);
+});
+
+test('the streak counts days played and never falls', () => {
+  const st = { day: 0, done: [false, false, false], streak: 0 };
+  assert.equal(completeDaily(st, 20261123, 1), 'first');
+  assert.equal(st.streak, 1);
+  assert.equal(completeDaily(st, 20261123, 1), '', 'once per slot');
+  assert.equal(completeDaily(st, 20261123, 0), 'more');
+  assert.equal(completeDaily(st, 20261123, 2), 'all');
+  assert.equal(st.streak, 1);
+  // ten days later (nine missed): the ticks clear, the streak stays and grows
+  rollDay(st, 20261203);
+  assert.deepEqual(st.done, [false, false, false]);
+  assert.equal(st.streak, 1);
+  assert.equal(completeDaily(st, 20261203, 2), 'first');
+  assert.equal(st.streak, 2);
+  assert.equal(completeDaily(st, 20261203, 7), '');
+  rollDay(st, NaN);
+  assert.equal(st.day, 20261203);
+});
+
+test('the system reads the date once, through the injected function', () => {
+  let calls = 0;
+  const events = createEvents();
+  const staged = [];
+  const game = {
+    events, progress: defaultProgress(), player: { x: 0, z: 0, wanted: 0, vehicle: null }, clock: 12, weather: { name: 'clear' },
+    streetEvents: { list, slug: 'beach', stage: (ev, spec) => { staged.push([ev.id, spec]); return true; } },
+    daynight: { setWeather(n) { game.weather.name = n; }, setHour(h) { game.clock = h; } },
+    hud: { toast() {} },
+  };
+  const d = createDaily(game, { now: () => { calls++; return new Date(2026, 10, 23, 8, 0); } });
+  assert.equal(calls, 1);
+  assert.equal(d.day, 20261123);
+  assert.equal(d.picks.length, 3);
+  // Go sets the twist and stages the car; then the event counts for its slot
+  for (const p of d.picks) {
+    assert.equal(d.go(p.slot), '');
+    const v = { spec: { id: p.twist.kind === 'class' ? p.twist.value : 'sedan' } };
+    assert.equal(d.slotFor(p.ev, v), p.slot, p.twist.kind);
+    if (p.twist.kind === 'class') {
+      assert.equal(d.slotFor(p.ev, { spec: { id: 'truck' } }), -1, 'the wrong class does not count');
+      assert.equal(staged[staged.length - 1][1], p.twist.value);
+    }
+    events.emit('streetEventEnd', { id: p.ev.id, medal: 'bronze', daily: p.slot });
+    assert.equal(d.slotFor(p.ev, v), -1, 'done for today');
+  }
+  assert.equal(d.doneCount, 3);
+  assert.equal(game.progress.loop.daily.streak, 1);
+  assert.equal(calls, 1, 'never read again');
+  // no medal, no tick; wanted: Go is refused
+  const g2 = { ...game, progress: defaultProgress(), police: { stars: 2 } };
+  const d2 = createDaily(g2, { now: () => new Date(2026, 10, 24) });
+  events.emit('streetEventEnd', { id: d2.picks[0].ev.id, medal: null, daily: 0 });
+  assert.equal(d2.doneCount, 0);
+  assert.equal(d2.go(0), 'Lose the police first');
+});
diff --git a/test/eventspots.test.js b/test/eventspots.test.js
new file mode 100644
index 0000000..2727b24
--- /dev/null
+++ b/test/eventspots.test.js
@@ -0,0 +1,132 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { allRegionCities } from './regionfixture.js';
+import { placeEvents, eventRamps, nearestEvent, regionSlug, QUOTA, GATE_APART, EDGE_MARGIN, INTRO_AHEAD, TRAP_RUN, DASH_RANGE } from '../src/world/eventspots.js';
+import { TEMPLATES, medalFor } from '../src/core/streetevents.js';
+import { EVENT_ID, REGION_SLUGS } from '../src/core/records.js';
+import { generateCity } from '../src/world/citygen.js';
+
+const cities = allRegionCities();
+const placed = new Map(cities.map(([id, c]) => [id, placeEvents(c)]));
+
+test('every region has 20 to 40 events from all six templates (30 here)', () => {
+  for (const [id] of cities) {
+    const ev = placed.get(id);
+    assert.ok(ev.length >= 20 && ev.length <= 40, id + ': ' + ev.length);
+    const n = {};
+    for (const e of ev) n[e.tpl] = (n[e.tpl] || 0) + 1;
+    for (const t of TEMPLATES) assert.ok(n[t] >= 3, id + ' ' + t + ': ' + n[t]);
+    assert.equal(ev.length, 30, id + ' ' + JSON.stringify(n));
+    for (const t of TEMPLATES) assert.ok(n[t] <= QUOTA[t] + (t === 'miss' ? 1 : 0));
+  }
+});
+
+test('placement is the same every time and ids are unique and savable', () => {
+  const all = new Set();
+  for (const [id, c] of cities) {
+    const again = placeEvents(c);
+    assert.deepEqual(again.map((e) => [e.id, e.x, e.z, e.targets]), placed.get(id).map((e) => [e.id, e.x, e.z, e.targets]));
+    for (const e of placed.get(id)) {
+      assert.ok(EVENT_ID.test(e.id), e.id);
+      assert.ok(!all.has(e.id), 'duplicate ' + e.id);
+      all.add(e.id);
+      assert.ok(e.id.startsWith('ev_' + regionSlug(c) + '_'));
+    }
+    assert.ok(REGION_SLUGS.includes(regionSlug(c)));
+  }
+  assert.equal(all.size, 150);
+});
+
+test('gates stand on a street, on land, inside the region, apart from each other', () => {
+  for (const [id, c] of cities) {
+    const ev = placed.get(id);
+    for (const e of ev) {
+      const st = c.streetAt(e.x, e.z);
+      assert.ok(st && st.name, id + ' ' + e.id + ' is not on a street');
+      assert.ok(c.isLand(e.x, e.z));
+      const m = e.intro ? 60 : EDGE_MARGIN;
+      assert.ok(e.x > c.crop.x0 + m && e.x < c.crop.x1 - m && e.z > c.crop.z0 + m && e.z < c.crop.z1 - m, e.id + ' near the edge');
+      assert.ok(Math.abs(Math.hypot(e.dx, e.dz) - 1) < 1e-6);
+      assert.ok(e.w >= 2.5 && e.w <= 20, e.id + ' width ' + e.w);
+      assert.ok(e.back >= 14 && e.back <= 40);
+      // the staging spot of a retry is on the road too
+      const sx = e.x - e.dx * e.back - e.dz * e.side, sz = e.z - e.dz * e.back + e.dx * e.side;
+      assert.ok(c.onRoad(sx, sz), e.id + ' retry spot off the road');
+      assert.ok(!c.inBuilding(sx, sz, 1));
+    }
+    for (let i = 0; i < ev.length; i++) {
+      for (let j = i + 1; j < ev.length; j++) {
+        assert.ok(Math.hypot(ev[i].x - ev[j].x, ev[i].z - ev[j].z) >= GATE_APART - 1, id + ': ' + ev[i].id + ' and ' + ev[j].id + ' too close');
+      }
+    }
+  }
+});
+
+test('the first gate is a near-miss run on the start street, just ahead of the start place', () => {
+  for (const [id, c] of cities) {
+    const e = placed.get(id)[0];
+    assert.equal(e.tpl, 'miss', id);
+    assert.ok(e.intro);
+    const dx = e.x - c.spawn.x, dz = e.z - c.spawn.z;
+    const ahead = dx * Math.cos(c.spawn.heading) + dz * Math.sin(c.spawn.heading);
+    assert.ok(ahead >= INTRO_AHEAD - 6 && ahead <= INTRO_AHEAD + 90, id + ' ahead ' + ahead);
+    assert.ok(Math.cos(e.heading - c.spawn.heading) > 0.9, 'the gate faces the way the car points');
+    // 20 seconds is enough at a town pace
+    assert.ok(Math.hypot(dx, dz) / 11 < 20);
+    assert.ok(e.targets.bronze <= 2);
+  }
+});
+
+test('each template keeps its rule', () => {
+  for (const [id, c] of cities) {
+    const ev = placed.get(id);
+    for (const e of ev) {
+      const t = e.targets;
+      assert.ok(t && Number.isFinite(t.gold) && Number.isFinite(t.silver) && Number.isFinite(t.bronze), e.id);
+      assert.ok(e.limit >= 20 && e.limit <= 90, e.id + ' limit ' + e.limit);
+      if (e.tpl === 'trap') {
+        assert.ok(e.run >= TRAP_RUN[0] && e.run <= TRAP_RUN[1]);
+        assert.ok(Math.abs(Math.hypot(e.tx - e.x, e.tz - e.z) - e.run) < 25, 'the line is down the same straight street');
+        assert.ok(c.streetAt(e.tx, e.tz), 'the line is on a street');
+        assert.ok(t.gold >= 60 && t.gold <= 90 && t.bronze >= 40, JSON.stringify(t));
+      } else if (e.tpl === 'jump') {
+        assert.ok(e.ramp && e.ramp.id.startsWith('stunt_') && e.ramp.event === e.id);
+        const along = (e.ramp.x - e.x) * e.dx + (e.ramp.z - e.z) * e.dz;
+        assert.ok(along >= 90 && along <= 160, 'the ramp is ahead of the gate: ' + along);
+        assert.ok(Math.cos(e.ramp.heading - e.heading) > 0.95);
+        assert.ok(!c.inBuilding(e.ramp.x, e.ramp.z, 4));
+        assert.ok(t.bronze >= 35 && t.gold <= 180, JSON.stringify(t));
+      } else if (e.tpl === 'dash') {
+        const m = Math.abs(e.tx - e.x) + Math.abs(e.tz - e.z);
+        assert.ok(m >= DASH_RANGE[0] && m <= DASH_RANGE[1]);
+        assert.ok(c.streetAt(e.tx, e.tz) && e.to);
+        assert.ok(t.bronze <= 90 && e.limit <= 90);
+      } else if (e.tpl === 'heat') {
+        assert.ok(e.level >= 1 && e.level <= 3);
+      }
+      // gold is reachable in principle, bronze is below it
+      assert.ok(medalFor(e, t.gold) === 'gold' && medalFor(e, t.bronze) === 'bronze');
+    }
+    const heats = ev.filter((e) => e.tpl === 'heat');
+    assert.deepEqual(heats.map((e) => e.level), [1, 2, 3]);
+    // the first heat escape and the first jump are a short drive from the start
+    const jump = ev.find((e) => e.tpl === 'jump');
+    for (const e of [heats[0], jump]) assert.ok(Math.hypot(e.x - c.spawn.x, e.z - c.spawn.z) < 800, id + ' ' + e.id + ' far from the start');
+    assert.equal(eventRamps(ev).length, ev.filter((e) => e.tpl === 'jump').length);
+    for (const r of eventRamps(ev)) for (const o of c.rampSpots.filter((s) => !s.event)) assert.ok(Math.hypot(r.x - o.x, r.z - o.z) > 100);
+  }
+});
+
+test('nearestEvent, and a city with no usable streets places nothing', () => {
+  const [, c] = cities[0];
+  const ev = placed.get(cities[0][0]);
+  const e = nearestEvent(ev, c.spawn.x, c.spawn.z);
+  assert.equal(e, ev[0]);
+  assert.equal(nearestEvent(ev, c.spawn.x, c.spawn.z, 'heat').tpl, 'heat');
+  assert.equal(nearestEvent([], 0, 0), null);
+  assert.deepEqual(placeEvents(null), []);
+  assert.deepEqual(placeEvents({ nodes: [], edges: [] }), []);
+  // the procedural island: whatever it gives is well formed
+  const isl = placeEvents(generateCity());
+  for (const x of isl) assert.ok(TEMPLATES.includes(x.tpl) && x.targets);
+});
diff --git a/test/flow.test.js b/test/flow.test.js
new file mode 100644
