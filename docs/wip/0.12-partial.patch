+  const v = car({ driver: 'player' });
+  game.vehicles.push(v);
+  game.player.vehicle = v;
+  // One step: move the player's car `dx, dz`, then the systems in the game's order.
+  game.tick = (dx = 0, dz = 0) => {
+    const pv = game.player.vehicle;
+    if (pv) {
+      pv.px = pv.x; pv.pz = pv.z;
