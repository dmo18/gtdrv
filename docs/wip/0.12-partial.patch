index 0000000..705459f
--- /dev/null
+++ b/src/core/custom.js
@@ -0,0 +1,77 @@
+// Free customization (docs/LOOP.md section f): paint, finish, wheels, window
+// tint and a decal for any car, kept per vehicle class. No currency: the
+// base set is open from the start; a few finishes and one wheel open with
+// medals. Pure data and rules (no DOM, no three.js).
+export const PAINTS = [
+  ['Signal red', 0xc21f1f], ['Sunset orange', 0xe2622a], ['Taxi yellow', 0xe8b820], ['Lime', 0x7fc41f],
+  ['Palm green', 0x1f7a44], ['Teal', 0x16877f], ['Sky blue', 0x3f9be0], ['Royal blue', 0x1f3fa8],
+  ['Violet', 0x6a3fc0], ['Hot pink', 0xe0408c], ['White', 0xf0f0ee], ['Silver', 0xa9aeb4],
+  ['Gunmetal', 0x4a4f57], ['Black', 0x121316], ['Sand', 0xc9b48a], ['Burgundy', 0x6e1524],
+];
+// Finishes: [name, metalness, roughness, clearcoat, clearcoat roughness, medals needed, of which gold].
+// The clearcoat is never 0, so every finish shares one shader program.
+export const FINISHES = [
+  ['Gloss', 0.12, 0.38, 1, 0.06, 0, 0],
+  ['Metallic', 0.6, 0.3, 1, 0.05, 0, 0],
+  ['Matte', 0.05, 0.85, 0.04, 0.6, 0, 0],
+  ['Satin', 0.3, 0.55, 0.3, 0.3, 0, 0],
+  ['Pearl', 0.45, 0.22, 1, 0.02, 5, 0],
+  ['Chrome', 1, 0.06, 1, 0.02, 15, 0],
+  ['Candy', 0.8, 0.16, 1, 0.01, 0, 10],
+];
+// Wheels: [name, rim color (multiplies the alloy), medals needed].
+export const WHEELS = [
+  ['Factory', 0xffffff, 0],
+  ['Black', 0x24262a, 0],
+  ['White', 0xf4f4f0, 0],
+  ['Bronze', 0xb07a3c, 0],
+  ['Red', 0xc22222, 0],
+  ['Gold', 0xe2b53a, 10],
+];
+// Window tint: [name, glass darkness 0..1].
+export const TINTS = [['Clear', 0], ['Light', 0.35], ['Dark', 0.6], ['Limo', 0.85]];
+// Decals: [name, stripe color or -1 for none, kind]. Drawn by the paint shader on the top faces.
+export const DECALS = [['None', -1, 0], ['Twin white', 0xf2f2f0, 1], ['Twin black', 0x101114, 1], ['Center red', 0xc21f1f, 2], ['Center gold', 0xe2b53a, 2]];
+export const LOOK_KEYS = ['paint', 'finish', 'wheels', 'tint', 'decal'];
+const SIZE = { paint: PAINTS.length, finish: FINISHES.length, wheels: WHEELS.length, tint: TINTS.length, decal: DECALS.length };
+export const LOOK_SIZE = SIZE;
+export const MAX_LOOKS = 40; // vehicle classes with a saved look
+
+// paint -1: the car keeps the color it came in.
+export const defaultLook = () => ({ paint: -1, finish: 0, wheels: 0, tint: 0, decal: 0 });
+export const isDefaultLook = (l) => !l || (l.paint < 0 && !l.finish && !l.wheels && !l.tint && !l.decal);
+
+// Is option `i` of `key` open with this many medals (any) and gold medals?
+export function unlocked(key, i, medals = 0, golds = 0) {
+  if (key === 'finish') return !!FINISHES[i] && medals >= FINISHES[i][5] && golds >= FINISHES[i][6];
+  if (key === 'wheels') return !!WHEELS[i] && medals >= WHEELS[i][2];
+  return i >= (key === 'paint' ? -1 : 0) && i < SIZE[key];
+}
+// What a locked option needs, as the menu says it.
+export function lockText(key, i) {
+  if (key === 'finish' && FINISHES[i]) return FINISHES[i][6] ? FINISHES[i][6] + ' gold medals' : FINISHES[i][5] + ' medals';
+  if (key === 'wheels' && WHEELS[i]) return WHEELS[i][2] + ' medals';
+  return '';
+}
+
+// A look read from storage: whole numbers in range, anything else the default.
+export function sanitizeLook(raw) {
+  const l = defaultLook();
+  if (raw === null || typeof raw !== 'object' || Array.isArray(raw)) return l;
+  for (const k of LOOK_KEYS) {
+    const v = Object.prototype.hasOwnProperty.call(raw, k) ? raw[k] : undefined;
+    if (Number.isInteger(v) && v >= (k === 'paint' ? -1 : 0) && v < SIZE[k]) l[k] = v;
+  }
+  return l;
+}
+
+// The paint code a mesh carries: the 24 bit color plus the finish and the
+// decal in the bits above (render/vehiclemats.js reads it back). A plain
+// color (finish 0, no decal) is its own code, so every other car is as before.
+export const CODE_FINISH = 0x1000000, CODE_DECAL = 0x10000000;
+export function paintCode(rgb, finish = 0, decal = 0) {
+  return (rgb & 0xffffff) + (finish & 15) * CODE_FINISH + (decal & 7) * CODE_DECAL;
+}
+export const codeRgb = (code) => code % CODE_FINISH;
+export const codeFinish = (code) => Math.floor(code / CODE_FINISH) % 16;
+export const codeDecal = (code) => Math.floor(code / CODE_DECAL) % 8;
diff --git a/src/core/daily.js b/src/core/daily.js
new file mode 100644
index 0000000..b07057e
--- /dev/null
+++ b/src/core/daily.js
@@ -0,0 +1,80 @@
+// The Daily Three (docs/LOOP.md section d): three of the region's events a
+// day, picked by a seed from the phone's local date, each with a small
+// twist (vehicle class, weather, time of day). A streak that counts the
+// days played and never falls. Pure: the date comes in as a number.
+import { createRng } from './rng.js';
+
+// yyyymmdd of a local date (the only place a real date is read: once at
+// start, through an injectable function in systems/daily.js).
+export function dayKey(date) {
+  const d = date instanceof Date && !Number.isNaN(date.getTime()) ? date : new Date(2026, 0, 1);
+  return d.getFullYear() * 10000 + (d.getMonth() + 1) * 100 + d.getDate();
+}
+export const validDay = (k) => Number.isInteger(k) && k >= 20200101 && k <= 29991231;
+
+// One easy, one skill, one mayhem.
+export const GROUPS = [['trap', 'jump'], ['miss', 'dash'], ['heat', 'wreck']];
+export const GROUP_NAMES = ['Easy', 'Skill', 'Mayhem'];
+export const TWIST_CLASSES = ['muscle', 'pickup', 'sports', 'compact', 'van', 'suv', 'convertible', 'sedan'];
+export const TWIST_WEATHER = [['rain', 'in the rain'], ['fog', 'in the fog'], ['overcast', 'under gray skies']];
+export const TWIST_TIMES = [[23, 'at midnight'], [6, 'at dawn'], [12.5, 'at noon'], [19.2, 'at sunset']];
+export const TWIST_KINDS = ['class', 'weather', 'time'];
+
+const hashOf = (s) => { let h = 2166136261; for (let i = 0; i < s.length; i++) h = Math.imul(h ^ s.charCodeAt(i), 16777619); return h >>> 0; };
+
+// The three picks for a day in a region: [{ slot, group, ev, twist: { kind,
+// value, text } }]. `labels`: spec id -> the class name shown ("Redtail").
+// A group with no event in the region is left out.
+export function dailyThree(events, day, slug, labels = {}) {
+  const rng = createRng((Math.imul(day >>> 0, 2654435761) ^ hashOf(slug || '')) >>> 0);
+  // which twist each slot gets: a seeded order of the three kinds
+  const kinds = TWIST_KINDS.slice();
+  for (let i = kinds.length - 1; i > 0; i--) {
+    const j = Math.floor(rng.next() * (i + 1));
+    const t = kinds[i]; kinds[i] = kinds[j]; kinds[j] = t;
+  }
+  const out = [];
+  for (let g = 0; g < GROUPS.length; g++) {
+    const pool = events.filter((e) => GROUPS[g].includes(e.tpl) && !e.intro);
+    const pick = rng.next(), tw = rng.next();
+    if (!pool.length) continue;
+    const ev = pool[Math.floor(pick * pool.length)];
+    const kind = kinds[g];
+    let twist;
+    if (kind === 'class') {
+      const id = TWIST_CLASSES[Math.floor(tw * TWIST_CLASSES.length)];
+      twist = { kind, value: id, text: 'in a ' + (labels[id] || id) };
+    } else if (kind === 'weather') {
+      const w = TWIST_WEATHER[Math.floor(tw * TWIST_WEATHER.length)];
+      twist = { kind, value: w[0], text: w[1] };
+    } else {
+      const t = TWIST_TIMES[Math.floor(tw * TWIST_TIMES.length)];
+      twist = { kind, value: t[0], text: t[1] };
+    }
+    out.push({ slot: g, group: GROUP_NAMES[g], ev, twist });
+  }
+  return out;
+}
+
+// The saved state moved to `day`: a new day clears the three ticks and
+// keeps the streak (a missed day costs nothing).
+export function rollDay(state, day) {
+  if (!validDay(day)) return state;
+  if (state.day !== day) {
+    state.day = day;
+    state.done[0] = state.done[1] = state.done[2] = false;
+  }
+  return state;
+}
+// A daily finished with a medal. The first one of a day adds to the
+// streak. Returns 'first' (streak grew), 'more', 'all' (third of the day)
+// or '' (already done).
+export function completeDaily(state, day, slot) {
+  rollDay(state, day);
+  if (!(slot >= 0 && slot < 3) || state.done[slot]) return '';
+  const first = !state.done[0] && !state.done[1] && !state.done[2];
+  state.done[slot] = true;
+  if (first) state.streak = Math.min(99999, state.streak + 1);
+  if (state.done[0] && state.done[1] && state.done[2]) return 'all';
+  return first ? 'first' : 'more';
+}
diff --git a/src/core/flow.js b/src/core/flow.js
new file mode 100644
index 0000000..6a1733c
--- /dev/null
+++ b/src/core/flow.js
@@ -0,0 +1,179 @@
+// Flow: the moment-to-moment loop (docs/LOOP.md section a). Pure logic,
+// fixed steps, no DOM, no three.js, no allocation per step.
+//
+// A run collects points from sources (near misses, drifts, air time, clean
+// passes, speed, takedowns, smashes, escapes). Each source also fills the
+// meter; a full meter raises the multiplier one tier (x1 to x5). The meter
+// holds for a moment after every source, then drains; an empty meter costs
+// one tier. The run is BANKED into the score by stopping at a safe spot
+// (bonus per tier), by finishing a street event, or when the flow has gone
+// cold. A hard crash costs tiers and a share of the run, a wreck or a bust
+// the whole run. The banked score is never touched.
+export const TIER_MAX = 5;
+export const FILL = { // meter units per source (1.0 is one tier at x1)
+  nearMiss: 0.25, oncoming: 0.35, shave: 0.1, overtake: 0.12, drift: 0.2, air: 0.3, jump: 0.3, speed: 0.03,
+  takedown: 0.4, chain: 0.6, smash: 0.07, escape: 1, stunt: 0.5, event: 0.5, other: 0.1,
+};
+export const FILL_PER_SECOND = { drift: 0.2, air: 0.15 }; // extra fill for a long drift or flight (seconds)
+export const FILL_CAP = 0.8; // one source never fills more than this (escape: a whole tier)
+export const TIER_COST = 0.35; // each tier needs this much more meter than the one before
+export const CARRY = 0.3; // meter left after a tier up
+export const HOLD_S = 3.2, HOLD_STEP = 0.4; // seconds before the drain starts: 3.2 at x1, 1.6 at x5
+export const DRAIN = 0.18, DRAIN_STEP = 0.05; // meter per second: 0.18 at x1, 0.38 at x5
+export const FAST_MPS = 22.35; // 50 mph: driving faster halves the drain
+export const SPEED_MPS = 31.3; // 70 mph: faster than this is a source (every SPEED_TICK seconds)
+export const SPEED_TICK = 0.5, SPEED_POINTS = 10;
+export const DROP_REFILL = 0.5; // meter after losing a tier
+export const COOL_S = 4; // seconds empty at x1 before the run banks by itself
+export const BANK_SPEED = 1, BANK_STILL_S = 0.7; // m/s and seconds standing still to bank
+export const BANK_BONUS = 0.1; // share of the run added per tier above x1 for a deliberate bank
+export const CRASH_MPS = 8; // an impact harder than this is a hard crash
+export const CRASH_TIERS = 2, CRASH_LOSS = 0.2; // tiers and share of the run lost
+export const CRASH_GAP_S = 1; // one crash penalty per this long
+export const MAX_RUN = 1000000, MAX_EVENT = 20000;
+
+const need = (tier) => 1 + TIER_COST * (tier - 1);
+
+// emit(kind, a, b): 'feed' (source, points), 'tier' (new tier, up),
+// 'bank' (amount, how: 'stop' | 'cool' | 'event'), 'crash' (lost, tier),
+// 'wipe' (lost). Optional.
+export function createFlow(emit = null) {
+  const st = {
+    run: 0, // points not banked yet
+    tier: 1,
+    meter: 0, // 0..1 of the current tier
+    hold: 0, // seconds until the drain starts
+    cold: 0, // seconds empty at x1
+    still: 0, // seconds standing still
+    speedT: 0,
+    crashGap: 0,
+    count: 0, // sources in this run
+    peak: 1, // highest tier of this run
+    banked: 0, // total banked through this object
+    best: 0, // biggest single bank
+    last: '', // last source (for the HUD)
+  };
+  const say = emit || (() => {});
+
+  // A source. Returns the points added to the run (after the multiplier).
+  // `seconds`: length of a drift or flight, for the extra fill.
+  st.feed = function feed(kind, points, seconds = 0) {
+    if (!(points > 0) || !Number.isFinite(points)) return 0;
+    const src = Object.hasOwn(FILL, kind) ? kind : 'other';
+    const amount = Math.min(MAX_EVENT, Math.round(points)) * st.tier;
+    st.run = Math.min(MAX_RUN, st.run + amount);
+    st.count++;
+    st.last = src;
+    let f = FILL[src] + (FILL_PER_SECOND[src] || 0) * Math.max(0, seconds || 0);
+    if (src !== 'escape' && f > FILL_CAP) f = FILL_CAP;
+    st.meter += f / need(st.tier);
+    st.cold = 0;
+    say('feed', src, amount);
+    while (st.meter >= 1 && st.tier < TIER_MAX) {
+      const over = (st.meter - 1) * need(st.tier);
+      st.tier++;
+      if (st.tier > st.peak) st.peak = st.tier;
+      st.meter = Math.min(1, CARRY + over / need(st.tier));
+      say('tier', st.tier, true);
+    }
+    if (st.meter > 1) st.meter = 1;
+    st.hold = HOLD_S - HOLD_STEP * (st.tier - 1);
+    return amount;
+  };
+
+  function reset() {
+    st.run = 0;
+    st.tier = 1;
+    st.meter = 0;
+    st.hold = 0;
+    st.cold = 0;
+    st.count = 0;
+    st.peak = 1;
+    st.last = '';
+  }
+
+  // Bank the run. how: 'stop' (bonus per tier), 'event' (bonus per tier),
+  // 'cool' (no bonus). Returns the points banked.
+  st.bank = function bank(how = 'stop') {
+    if (!(st.run > 0)) { reset(); return 0; }
+    const bonus = how === 'cool' ? 0 : Math.round(st.run * BANK_BONUS * (st.tier - 1));
+    const amount = Math.min(MAX_RUN, st.run + bonus);
+    st.banked += amount;
+    if (amount > st.best) st.best = amount;
+    const tier = st.tier;
+    reset();
+    say('bank', amount, how, tier);
+    return amount;
+  };
+
+  // A hard crash: tiers and a share of the run. Returns the points lost.
+  st.crash = function crash() {
+    if (st.crashGap > 0) return 0;
+    st.crashGap = CRASH_GAP_S;
+    if (st.tier === 1 && !(st.run > 0)) return 0;
+    const lost = Math.round(st.run * CRASH_LOSS);
+    st.run -= lost;
+    st.tier = Math.max(1, st.tier - CRASH_TIERS);
+    st.meter = 0;
+    st.hold = 0;
+    say('crash', lost, st.tier);
+    return lost;
+  };
+
+  // Wrecked, busted or downed: the whole run is gone.
+  st.wipe = function wipe() {
+    const lost = st.run;
+    const had = lost > 0 || st.tier > 1;
+    reset();
+    if (had) say('wipe', lost);
+    return lost;
+  };
+
+  // One fixed step. facts: { speed (m/s, absolute), driving (in a car or
+  // boat), airborne, wanted (stars > 0), canBank (false holds the bank
+  // back, e.g. a running event) }.
+  st.step = function step(dt, facts) {
+    if (!(dt > 0)) return;
+    const speed = facts ? +facts.speed || 0 : 0;
+    const driving = !!(facts && facts.driving);
+    const air = !!(facts && facts.airborne);
+    if (st.crashGap > 0) st.crashGap -= dt;
+    // Speed as a source.
+    if (driving && !air && speed >= SPEED_MPS) {
+      st.speedT += dt;
+      if (st.speedT >= SPEED_TICK) {
+        st.speedT -= SPEED_TICK;
+        st.feed('speed', SPEED_POINTS);
+      }
+    } else st.speedT = 0;
+    // Hold, then drain (frozen in the air, halved at speed).
+    if (st.hold > 0) st.hold -= dt;
+    else if (!air && (st.meter > 0 || st.tier > 1)) {
+      const rate = (DRAIN + DRAIN_STEP * (st.tier - 1)) * (driving && speed >= FAST_MPS ? 0.5 : 1);
+      st.meter -= rate * dt;
+      if (st.meter <= 0) {
+        if (st.tier > 1) {
+          st.tier--;
+          st.meter = DROP_REFILL;
+          say('tier', st.tier, false);
+        } else st.meter = 0;
+      }
+    }
+    if (!(st.run > 0)) { st.still = 0; st.cold = 0; return; }
+    const wanted = !!(facts && facts.wanted);
+    const may = !facts || facts.canBank !== false;
+    // Standing still at a safe spot banks the run.
+    if (may && !wanted && speed < BANK_SPEED && !air) {
+      st.still += dt;
+      if (st.still >= BANK_STILL_S) { st.still = 0; st.bank('stop'); return; }
+    } else st.still = 0;
+    // A cold flow banks by itself, without the bonus.
+    if (may && !wanted && st.tier === 1 && st.meter <= 0 && st.hold <= 0) {
+      st.cold += dt;
+      if (st.cold >= COOL_S) { st.cold = 0; st.bank('cool'); }
+    } else st.cold = 0;
+  };
+
+  st.reset = reset;
+  return st;
+}
diff --git a/src/core/records.js b/src/core/records.js
new file mode 100644
index 0000000..4b28f43
--- /dev/null
+++ b/src/core/records.js
@@ -0,0 +1,131 @@
+// The Records board's data (docs/LOOP.md section c): medals and best values
+// by event, the best flow run by region, totals, vehicles driven and the
+// distance by region. Pure rules over `progress.loop` (core/save.js keeps
+// and sanitizes it). No DOM, no three.js, no clock.
+import { medalRank, better, TEMPLATES, TEMPLATE_INFO } from './streetevents.js';
+
+export const REGION_SLUGS = ['beach', 'downtown', 'north', 'west', 'south', 'miami', 'island'];
+export const REGION_NAMES = { beach: 'Miami Beach', downtown: 'Downtown', north: 'North Side', west: 'Little Havana', south: 'South Shore', miami: 'All of Miami', island: 'The Island' };
+export const TOTAL_KEYS = ['banked', 'runs', 'nearMiss', 'passes', 'drifts', 'jumps', 'takedowns', 'smashes', 'escapes', 'events', 'crashes'];
+export const BEST_KEYS = ['mph', 'jumpFt', 'tier', 'chain'];
+export const EVENT_ID = /^ev_[a-z]{4,8}_(trap|miss|jump|dash|heat|wreck)_\d{1,2}$/;
+export const MAX_EVENTS = 320, MAX_DRIVEN = 40, MAX_VALUE = 1e9;
+
+export function defaultLoop() {
+  const totals = {}, best = {};
+  for (const k of TOTAL_KEYS) totals[k] = 0;
+  for (const k of BEST_KEYS) best[k] = 0;
+  return {
+    events: {}, // id -> { m: medal or '', b: best value, n: tries }
+    flow: {}, // region -> biggest banked run
+    dist: {}, // region -> meters driven, walked, sailed and flown
+    totals, best,
+    driven: [], // spec ids of the vehicles driven
+    daily: { day: 0, done: [false, false, false], streak: 0 },
+    intro: { step: 0, done: false },
+    looks: {}, // spec id -> { paint, finish, wheels, tint, decal }
+  };
+}
+
+// The loop record of a progress object (made when missing: old saves, tests).
+export function loopOf(progress) {
+  if (!progress.loop) progress.loop = defaultLoop();
+  return progress.loop;
+}
+
+// A finished run of an event: keeps the best medal and the best value.
+// Returns { medal: the best medal now, newMedal, newBest, prev }.
+const RES = { medal: '', newMedal: false, newBest: false, prev: NaN };
+export function recordEvent(loop, ev, value, medal) {
+  let r = loop.events[ev.id];
+  if (!r) {
+    if (Object.keys(loop.events).length >= MAX_EVENTS) { RES.medal = medal || ''; RES.newMedal = false; RES.newBest = false; RES.prev = NaN; return RES; }
+    r = loop.events[ev.id] = { m: '', b: NaN, n: 0 };
+  }
+  r.n = Math.min(99999, r.n + 1);
+  RES.prev = r.b;
+  RES.newBest = Number.isFinite(value) && better(ev.tpl, value, r.b);
+  if (RES.newBest) r.b = Math.round(value * 100) / 100;
+  RES.newMedal = medalRank(medal) > medalRank(r.m);
+  if (RES.newMedal) r.m = medal;
+  RES.medal = r.m;
+  loop.totals.events = Math.min(MAX_VALUE, loop.totals.events + 1);
+  return RES;
+}
+// An event given up or failed still counts as a try.
+export function recordTry(loop, ev) {
+  const r = loop.events[ev.id];
+  if (r) r.n = Math.min(99999, r.n + 1);
+}
+
+// A banked flow run. Returns true when it is the region's best.
+export function recordBank(loop, slug, amount) {
+  if (!(amount > 0)) return false;
+  loop.totals.banked = Math.min(MAX_VALUE, loop.totals.banked + Math.round(amount));
+  loop.totals.runs = Math.min(MAX_VALUE, loop.totals.runs + 1);
+  if (!REGION_SLUGS.includes(slug)) return false;
+  if (amount > (loop.flow[slug] || 0)) {
+    loop.flow[slug] = Math.min(MAX_VALUE, Math.round(amount));
+    return true;
+  }
+  return false;
+}
+export function addTotal(loop, key, n = 1) {
+  if (Object.hasOwn(loop.totals, key) && n > 0) loop.totals[key] = Math.min(MAX_VALUE, loop.totals[key] + n);
+}
+export function noteBest(loop, key, v) {
+  if (Object.hasOwn(loop.best, key) && v > loop.best[key]) { loop.best[key] = Math.round(v * 10) / 10; return true; }
+  return false;
+}
+export function addDistance(loop, slug, meters) {
+  if (REGION_SLUGS.includes(slug) && meters > 0) loop.dist[slug] = Math.min(1e12, (loop.dist[slug] || 0) + meters);
+}
+// Returns true the first time a vehicle class is driven.
+export function noteVehicle(loop, specId) {
+  if (typeof specId !== 'string' || loop.driven.includes(specId) || loop.driven.length >= MAX_DRIVEN) return false;
+  loop.driven.push(specId);
+  return true;
+}
+
+// Medal counts over every saved event, or one region's ("ev_<slug>_").
+export function medalCounts(loop, slug = null) {
+  const out = { gold: 0, silver: 0, bronze: 0, any: 0, tried: 0 };
+  const pre = slug ? 'ev_' + slug + '_' : 'ev_';
+  for (const id in loop.events) {
+    if (!id.startsWith(pre)) continue;
+    const r = loop.events[id];
+    out.tried++;
+    if (r.m) { out[r.m]++; out.any++; }
+  }
+  return out;
+}
+export const bestFlow = (loop) => REGION_SLUGS.reduce((m, s) => Math.max(m, loop.flow[s] || 0), 0);
+export const totalDistance = (loop) => REGION_SLUGS.reduce((m, s) => m + (loop.dist[s] || 0), 0);
+
+// The board's rows for a region's event list: per template the medals
+// earned out of the events there, and the events themselves in order.
+export function boardRows(loop, events) {
+  const rows = [];
+  for (const tpl of TEMPLATES) {
+    const list = events.filter((e) => e.tpl === tpl);
+    if (!list.length) continue;
+    const row = { tpl, title: TEMPLATE_INFO[tpl].title, total: list.length, gold: 0, silver: 0, bronze: 0, items: [] };
+    for (const e of list) {
+      const r = loop.events[e.id] || null;
+      if (r && r.m) row[r.m]++;
+      row.items.push({ ev: e, medal: r ? r.m : '', best: r ? r.b : NaN, tries: r ? r.n : 0 });
+    }
+    rows.push(row);
+  }
+  return rows;
+}
+// The three events closest to their next medal: no medal first (tried
+// ones before untried), then bronze, then silver. Gold ones are done.
+export function closestMedals(loop, events, n = 3) {
+  const score = (e) => {
+    const r = loop.events[e.id];
+    if (!r) return 1;
+    return r.m === 'gold' ? 9 : r.m === 'silver' ? 3 : r.m === 'bronze' ? 2 : 0;
+  };
+  return events.filter((e) => score(e) < 9).map((e, i) => ({ e, s: score(e), i })).sort((a, b) => a.s - b.s || a.i - b.i).slice(0, n).map((x) => x.e);
+}
