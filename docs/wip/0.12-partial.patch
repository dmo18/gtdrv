+  EV('jump', { x: 100, z: 800, tx: 195, tz: 800, ramp: { id: 'stunt_beach_jump_1', x: 195, z: 800, event: 'ev_beach_jump_1' }, limit: 25, targets: jumpTargets(95, 0.245, 1.5) }),
